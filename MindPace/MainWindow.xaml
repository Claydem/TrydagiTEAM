<Window x:Class="MindPace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MindPace — Планер та Фокус"
        Height="540" Width="840" MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15,0">
            <TextBlock Text="MindPace — Персональний планер та тайм-менеджер" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="1. Проекти">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Новий проект" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Назва проекту:" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTitle" Padding="5" Margin="0,0,0,10"/>

                            <TextBlock Text="Опис:" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDesc" Height="50" TextWrapping="Wrap" Padding="5" Margin="0,0,0,10"/>

                            <TextBlock Text="Оцінка годин:" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtHours" Text="10" Padding="5" Margin="0,0,0,10"/>

                            <TextBlock Text="Дедлайн:" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpDeadline" Margin="0,0,0,15"/>

                            <Button Content="Додати проект" Height="34" Click="BtnAdd_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icProjects">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Background="#F8FAFC" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="12" Margin="0,2,0,4"/>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Дедлайн: "/>
                                                        <Run Text="{Binding Deadline, Mode=OneWay, StringFormat=dd.MM.yyyy}"/>
                                                        <Run Text=" | План: "/>
                                                        <Run Text="{Binding TotalEstimatedHours, Mode=OneWay}"/>
                                                        <Run Text=" год | Факт: "/>
                                                        <Run Text="{Binding HoursWorked, Mode=OneWay}"/>
                                                        <Run Text=" год"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DailyTimeFormatted, Mode=OneWay}" Foreground="#D97706" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Видалити" Tag="{Binding}" Click="BtnDelete_Click" Foreground="#DC2626" Width="75" Height="28" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="2. Розподіл часу">
                <Grid Margin="15">
                    <StackPanel>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <TextBlock x:Name="lblTotalSchedule" Text="Щоб встигнути всі проекти, сьогодні треба працювати: 0 год" FontSize="15" FontWeight="Bold" Foreground="#1E40AF"/>
                        </Border>
                        <TextBlock Text="Рекомендований темп за активними проектами:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox x:Name="lstSchedule" Height="260" DisplayMemberPath="DisplayInfo"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="3. Фокус уваги">
                <Grid Margin="15">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Таймер фокусу (Pomodoro)" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock x:Name="lblTimer" Text="25:00" FontSize="64" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <TextBlock Text="Працювати над проектом:" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbFocusProjects" DisplayMemberPath="Title" Width="260" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnTimerStart" Content="Старт" Width="100" Height="36" Click="BtnTimerStart_Click" Margin="0,0,10,0" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
                            <Button Content="Скинути" Width="100" Height="36" Click="BtnTimerReset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
