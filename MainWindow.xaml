<Window x:Class="MindPace_Starter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MindPace" Height="500" Width="750"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Верхня панель (шапка) -->
            <RowDefinition Height="50"/>
            <!-- Основна область із вкладками -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Шапка програми -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,0">
            <TextBlock Text="MindPace — Каркас додатку" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <!-- Меню перемикання між 3 розділами -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- 1. Розділ проектів -->
            <TabItem Header="Проекти">
                <Grid Margin="10">
                    <TextBlock Text="Тут буде форма додавання проектів" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            <!-- 2. Розділ розподілу часу -->
            <TabItem Header="Розподіл часу">
                <Grid Margin="15">
                    <Border Background="#F4F6F7" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Розділ у розробці" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Тут буде модуль розрахунку щоденного темпу роботи за дедлайнами." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <!-- 3. Розділ таймера фокусу -->
            <TabItem Header="Фокус уваги">
                <Grid Margin="10">
                    <TextBlock Text="Тут буде таймер фокусу" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>