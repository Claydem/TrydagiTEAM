<Window x:Class="MindPace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MindPace" Height="500" Width="750"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Верхня панель (шапка) -->
            <RowDefinition Height="50"/>
            <!-- Основна область із вкладками -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка додатку -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,0">
            <TextBlock Text="MindPace — Каркас додатку" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <!-- Вкладки меню додатку -->
        <TabControl Grid.Row="1" Margin="10">
            
            <!-- 1. Розділ проектів -->
            <TabItem Header="Проекти">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Форма додавання проекту -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Назва проекту:" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTitle" Margin="0,0,0,10" Padding="5"/>

                        <TextBlock Text="Опис:" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDesc" Height="60" TextWrapping="Wrap" Margin="0,0,0,10" Padding="5"/>

                        <TextBlock Text="Оцінка годин:" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtHours" Text="10" Margin="0,0,0,10" Padding="5"/>

                        <TextBlock Text="Дедлайн:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpDeadline" Margin="0,0,0,15"/>

                        <Button Content="Додати проект" Height="32" Click="BtnAdd_Click"/>
                    </StackPanel>

                    <!-- Список проектів -->
                    <ListBox Grid.Column="1" x:Name="lstProjects">
                        <ListBoxItem Content="Приклад проекту 1 (дедлайн через 5 днів)"/>
                        <ListBoxItem Content="Приклад проекту 2 (дедлайн через 10 днів)"/>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- 2. Розділ розподілу часу -->
            <TabItem Header="Розподіл часу">
                <Grid Margin="15">
                    <Border Background="#F4F6F7" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Розділ у розробці" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Тут буде модуль розрахунку щоденного темпу роботи за дедлайнами." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. Розділ таймера фокусу -->
            <TabItem Header="Фокус уваги">
                <Grid Margin="15">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Таймер фокусу" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        
                        <!-- Табло таймера -->
                        <TextBlock x:Name="lblTimer" Text="25:00" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <!-- Кнопки керування відліком -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Старт" Width="100" Height="35" Margin="0,0,10,0" Click="BtnStart_Click"/>
                            <Button Content="Пауза" Width="100" Height="35" Click="BtnPause_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
